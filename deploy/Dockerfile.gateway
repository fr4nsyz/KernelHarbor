FROM node:22-alpine

WORKDIR /app

COPY package.json ./
RUN npm install --omit=dev

COPY plugin.mjs ./
COPY signer.mjs ./
COPY gateway.mjs ./
COPY openclaw.plugin.json ./
COPY rules/ ./rules/
COPY dashboard/ ./dashboard/

ENV KH_DASHBOARD_PORT=8181
ENV KH_EXTERNAL_ANALYSIS=1
EXPOSE 8181 28079 28080

ENTRYPOINT ["node", "gateway.mjs"]
